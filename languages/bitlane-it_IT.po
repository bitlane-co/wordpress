#. Plugin Name of the plugin
#: bitlane.php
msgid "Bitlane Search"
msgstr "Bitlane Search"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: bitlane.php
msgid "https://bitlane.co"
msgstr "https://bitlane.co"

#. Description of the plugin
#: bitlane.php
msgid "Fast search for WordPress and WooCommerce: connect to Bitlane, sync your products and posts, and add the search widget."
msgstr "Ricerca veloce per WordPress e WooCommerce: collega il sito a Bitlane, sincronizza prodotti e articoli e aggiungi il widget di ricerca."

#. Author of the plugin
#: bitlane.php
#: src/Admin/AdminPage.php:56
#: src/Admin/AdminPage.php:57
#: build/index.js:12
msgid "Bitlane"
msgstr "Bitlane"

#: src/Admin/AdminPage.php:106
msgid "Connected to Bitlane."
msgstr "Collegato a Bitlane."

#: src/Admin/AdminPage.php:168
msgid "Bitlane ended this site's connection, so its search stopped updating."
msgstr "Bitlane ha chiuso il collegamento di questo sito, quindi la sua ricerca non si aggiorna più."

#: src/Admin/AdminPage.php:170
msgid "Connect again"
msgstr "Collega di nuovo"

#: src/Admin/AdminPage.php:183
msgid "Settings"
msgstr "Impostazioni"

#: src/Connection/BitlaneApi.php:57
msgid "Bitlane ended this site's connection. Connect again to keep searching."
msgstr "Bitlane ha chiuso il collegamento di questo sito. Collegalo di nuovo per continuare a cercare."

#: src/Connection/BitlaneApi.php:66
msgid "Bitlane could not do that. Try again in a moment."
msgstr "Bitlane non è riuscito a farlo. Riprova tra poco."

#: src/Connection/OAuthClient.php:71
#: build/index.js:12
msgid "Bitlane could not be reached. Try again in a moment."
msgstr "Impossibile raggiungere Bitlane. Riprova tra poco."

#: src/Connection/OAuthClient.php:146
msgid "The connection request expired or came from elsewhere. Click Connect again."
msgstr "La richiesta di collegamento è scaduta o è arrivata da altrove. Fai di nuovo clic su Collega."

#: src/Connection/OAuthClient.php:152
msgid "The connection was declined in Bitlane."
msgstr "Il collegamento è stato rifiutato in Bitlane."

#: src/Connection/OAuthClient.php:156
msgid "The answer did not come from Bitlane."
msgstr "La risposta non è arrivata da Bitlane."

#: src/Connection/OAuthClient.php:159
msgid "Bitlane sent no authorization code."
msgstr "Bitlane non ha inviato alcun codice di autorizzazione."

#: src/Connection/OAuthClient.php:184
#: src/Connection/OAuthClient.php:204
#: src/Sync/Credentials.php:87
msgid "This site isn't connected to Bitlane."
msgstr "Questo sito non è collegato a Bitlane."

#: src/Connection/OAuthClient.php:264
msgid "Bitlane does not accept new connections right now."
msgstr "Bitlane non accetta nuovi collegamenti in questo momento."

#. translators: %s: the site's host.
#: src/Connection/OAuthClient.php:277
#, php-format
msgid "Bitlane for WordPress (%s)"
msgstr "Bitlane per WordPress (%s)"

#: src/Connection/OAuthClient.php:288
msgid "Bitlane refused to register this site."
msgstr "Bitlane ha rifiutato di registrare questo sito."

#: src/Connection/OAuthClient.php:325
msgid "Bitlane refused the connection."
msgstr "Bitlane ha rifiutato il collegamento."

#: src/Http/ConnectionController.php:472
msgid "Connect the site to Bitlane first."
msgstr "Prima collega il sito a Bitlane."

#: src/Http/ConnectionController.php:489
msgid "Choose at least one kind of content to search."
msgstr "Scegli almeno un tipo di contenuto da cercare."

#: build/index.js:1
msgid "Connect your site to Bitlane"
msgstr "Collega il tuo sito a Bitlane"

#: build/index.js:1
msgid "Bitlane ended this site’s connection, so its search stopped updating. Connect again to resume."
msgstr "Bitlane ha chiuso il collegamento di questo sito, quindi la sua ricerca non si aggiorna più. Collegalo di nuovo per riprendere."

#: build/index.js:1
msgid "You’ll sign in to Bitlane (or create an account) and allow this site to use it. Bitlane then sets up:"
msgstr "Accederai a Bitlane (o creerai un account) e consentirai a questo sito di usarlo. Bitlane poi configura:"

#: build/index.js:1
msgid "an engine, or one your project already has"
msgstr "un engine, o uno che il tuo progetto ha già"

#. translators: %s: the site's languages, e.g. English, Italiano.
#: build/index.js:2
#, js-format
msgid "indexes for your products and posts in %s"
msgstr "gli indici per i tuoi prodotti e articoli in %s"

#: build/index.js:2
msgid "a search widget for your storefront"
msgstr "un widget di ricerca per il tuo negozio"

#: build/index.js:2
msgid "keys that only reach this site’s indexes"
msgstr "chiavi che raggiungono solo gli indici di questo sito"

#: build/index.js:2
msgid "Connect to Bitlane"
msgstr "Collega a Bitlane"

#: build/index.js:2
msgid "Choose a project"
msgstr "Scegli un progetto"

#: build/index.js:2
msgid "Bitlane project for this site"
msgstr "Progetto Bitlane per questo sito"

#: build/index.js:2
msgid "Continue"
msgstr "Continua"

#: build/index.js:2
msgid "Engine"
msgstr "Engine"

#: build/index.js:2
msgid "A new engine"
msgstr "Un nuovo engine"

#: build/index.js:2
msgid "Content to search"
msgstr "Contenuti da cercare"

#. translators: 1: a post type's name, 2: how many are published.
#: build/index.js:3
#, js-format
msgid "%1$s (%2$d)"
msgstr "%1$s (%2$d)"

#: build/index.js:4
msgid "Filters"
msgstr "Filtri"

#: build/index.js:4
msgid "Products with variations"
msgstr "Prodotti con varianti"

#: build/index.js:4
msgid "One result per variation (recommended)"
msgstr "Un risultato per variante (consigliato)"

#: build/index.js:4
msgid "Color, size and stock filter exactly: “red, XL, in stock” finds only products with a red XL in stock. Each variation counts as a record in your plan."
msgstr "Colore, taglia e disponibilità filtrano con precisione: “rosso, XL, disponibile” trova solo i prodotti con una XL rossa disponibile. Ogni variante conta come un record del tuo piano."

#: build/index.js:4
msgid "One result per product"
msgstr "Un risultato per prodotto"

#: build/index.js:4
msgid "Fewer records, but filters combine variations: a red S and a blue XL match “red, XL”, and stock is the product’s."
msgstr "Meno record, ma i filtri combinano le varianti: una S rossa e una XL blu corrispondono a “rosso, XL”, e la disponibilità è quella del prodotto."

#: build/index.js:12
msgid "Save and set up"
msgstr "Salva e configura"

#: build/index.js:4
msgid "Setting up"
msgstr "Configurazione in corso"

#: build/index.js:2
msgid "Bitlane could not set this site up."
msgstr "Bitlane non è riuscito a configurare questo sito."

#: build/index.js:4
msgid "Bitlane is creating the engine, indexes, keys and search widget. A new engine takes a minute or two."
msgstr "Bitlane sta creando l’engine, gli indici, le chiavi e il widget di ricerca. Un nuovo engine richiede un paio di minuti."

#: build/index.js:11
msgid "Connected"
msgstr "Collegato"

#: build/index.js:12
msgid "Open in Bitlane"
msgstr "Apri in Bitlane"

#: build/index.js:4
msgid "Engines"
msgstr "Engine"

#: build/index.js:4
msgid "Search widget"
msgstr "Widget di ricerca"

#: build/index.js:12
msgid "Disconnect this site from Bitlane? Its search stops updating; the engine and indexes stay in Bitlane."
msgstr "Scollegare questo sito da Bitlane? La sua ricerca smetterà di aggiornarsi; l’engine e gli indici restano in Bitlane."

#: build/index.js:12
msgid "Disconnect"
msgstr "Scollega"

#. translators: 1: the site's name, 2: its address.
#: build/index.js:12
#, js-format
msgid "%1$s (%2$s) is connected to Bitlane."
msgstr "%1$s (%2$s) è collegato a Bitlane."

#: build/index.js:12
msgid "Save"
msgstr "Salva"

#: build/index.js:12
msgid "Overview"
msgstr "Panoramica"

#: build/index.js:12
msgid "Search"
msgstr "Ricerca"

#: build/index.js:12
msgid "Connection"
msgstr "Collegamento"

#: build/index.js:4
msgid "Brand color"
msgstr "Colore del brand"

#: build/index.js:4
msgid "The search widget’s buttons and highlights, from your theme. Bitlane uses it for a new widget; after that, change the colors in Bitlane."
msgstr "I pulsanti e i dettagli evidenziati del widget di ricerca, dal tuo tema. Bitlane lo usa per un nuovo widget; dopo, cambia i colori in Bitlane."

#: build/index.js:4
msgid "Logo"
msgstr "Logo"

#: build/index.js:4
msgid "Shown at the top of the search widget’s filters, from your site. Bitlane uses it for a widget without a logo; after that, change it in Bitlane."
msgstr "Mostrato in alto sopra i filtri del widget di ricerca, dal tuo sito. Bitlane lo usa per un widget senza logo; dopo, cambialo in Bitlane."

#: build/index.js:4
msgid "Choose a logo"
msgstr "Scegli un logo"

#: build/index.js:4
msgid "Use this logo"
msgstr "Usa questo logo"

#: build/index.js:4
msgid "Replace"
msgstr "Sostituisci"

#: build/index.js:4
msgid "Remove"
msgstr "Rimuovi"

#: src/Sources/ProductSource.php:52
msgid "Products"
msgstr "Prodotti"

#: build/index.js:2
msgid "Each kind gets its own index, kept up to date. Shoppers find those in the search widget in one list of results; the others are for your own use."
msgstr "Ogni tipo ha il suo indice, sempre aggiornato. I clienti trovano quelli nel widget di ricerca in un unico elenco di risultati; gli altri sono per il tuo uso."

#: build/index.js:3
msgid "In the search widget"
msgstr "Nel widget di ricerca"

#: build/index.js:5
msgid "Content"
msgstr "Contenuti"

#: build/index.js:6
msgid "Each kind of content has its own index, kept up to date as it changes."
msgstr "Ogni tipo di contenuto ha il suo indice, aggiornato a ogni modifica."

#. translators: 1: the error, 2: when it happened.
#: build/index.js:7
#, js-format
msgid "Last error: %1$s (%2$s)"
msgstr "Ultimo errore: %1$s (%2$s)"

#. translators: 1: items synced, 2: items in all.
#: build/index.js:9
#, js-format
msgid "Syncing: %1$s of %2$s"
msgstr "Sincronizzazione: %1$s di %2$s"

#. translators: %s: when.
#: build/index.js:10
#, js-format
msgid "Synced %s"
msgstr "Sincronizzato il %s"

#: build/index.js:10
msgid "Not synced yet"
msgstr "Non ancora sincronizzato"

#: build/index.js:10
msgid "Not in the search widget"
msgstr "Non nel widget di ricerca"

#: build/index.js:10
msgid "Resync"
msgstr "Risincronizza"

#: build/index.js:10
msgid "Resync all"
msgstr "Risincronizza tutto"

#. translators: %s: how many.
#: build/index.js:11
#, js-format
msgid "%s change waiting to sync"
msgid_plural "%s changes waiting to sync"
msgstr[0] "%s modifica in attesa di sincronizzazione"
msgstr[1] "%s modifiche in attesa di sincronizzazione"

#: src/Sources/ProductSource.php:80
msgid "Price"
msgstr "Prezzo"

#: build/index.js:4
msgid "What shoppers can narrow the results by, in the order they show."
msgstr "Ciò con cui i clienti possono restringere i risultati, nell’ordine in cui appaiono."

#: build/index.js:2
msgid "Drag to change the order"
msgstr "Trascina per cambiare l’ordine"

#: build/index.js:4
msgid "The widget opens from your theme’s search box. Its look and texts are set in Bitlane."
msgstr "Il widget si apre dalla casella di ricerca del tema. Aspetto e testi si impostano in Bitlane."

#: build/index.js:5
msgid "Show on the storefront"
msgstr "Mostra nel negozio"

#: build/index.js:5
msgid "Off: the storefront keeps your theme’s own search."
msgstr "Disattivato: il negozio mantiene la ricerca del tema."

#: build/index.js:5
msgid "Bitlane has no active widget for this site yet."
msgstr "Bitlane non ha ancora un widget attivo per questo sito."

#: build/index.js:3
msgid "Languages"
msgstr "Lingue"

#. translators: %s: the multilingual plugin, e.g. WPML.
#: build/index.js:4
#, js-format
msgid "Each language from %s gets its own indexes, and the widget searches the one of the page. A language you add later is added on its own."
msgstr "Ogni lingua di %s ha i suoi indici, e il widget cerca in quelli della lingua della pagina. Una lingua aggiunta in seguito si aggiunge da sola."

#. translators: %s: the site's languages, e.g. English, Italiano.
#: build/index.js:6
#, js-format
msgid "Each kind of content has its own index in each language (%s), kept up to date as it changes."
msgstr "Ogni tipo di contenuto ha il suo indice in ogni lingua (%s), aggiornato a ogni modifica."

#. translators: 1: a language, e.g. Italiano, 2: items synced, 3: items in all.
#: build/index.js:8
#, js-format
msgid "Syncing %1$s: %2$s of %3$s"
msgstr "Sincronizzazione in %1$s: %2$s di %3$s"

#: build/index.js:4
msgid "Where your content is searched: an index per kind of content and language."
msgstr "Dove si cercano i tuoi contenuti: un indice per tipo di contenuto e lingua."

#: build/index.js:4
msgid "Open engine"
msgstr "Apri l'engine"

#: build/index.js:4
#: build/index.js:5
msgid "Open"
msgstr "Apri"

#: build/index.js:4
msgid "No indexes yet."
msgstr "Ancora nessun indice."

#: build/index.js:4
msgid "Active"
msgstr "Attivo"

#: build/index.js:4
msgid "Draft"
msgstr "Bozza"

#: build/index.js:4
msgid "Running"
msgstr "In esecuzione"

#: build/index.js:4
msgid "Starting"
msgstr "In avvio"

#: build/index.js:4
msgid "Updating"
msgstr "In aggiornamento"

#: build/index.js:4
msgid "Moving"
msgstr "In spostamento"

#: build/index.js:4
msgid "Failed"
msgstr "Non riuscito"

#: build/index.js:4
msgid "Deleting"
msgstr "In eliminazione"

#: build/index.js:4
msgid "Stopped"
msgstr "Terminato"

#. translators: 1: what the widget searches, e.g. Products, Posts; 2: its languages, e.g. English, Italiano.
#: build/index.js:5
#, js-format
msgid "%1$s in %2$s"
msgstr "%1$s in %2$s"

#: src/Sources/ProductSource.php:81
msgid "Availability"
msgstr "Disponibilità"

#: src/Site/Site.php:198
msgid "Relevance"
msgstr "Rilevanza"

#: src/Site/Site.php:202
msgid "Newest"
msgstr "Più recenti"

#: src/Site/Site.php:206
msgid "Oldest"
msgstr "Meno recenti"

#: src/Site/Site.php:210
msgid "Name: A to Z"
msgstr "Nome: dalla A alla Z"

#: src/Site/Site.php:220
msgid "Price: low to high"
msgstr "Prezzo: dal più basso"

#: src/Site/Site.php:224
msgid "Price: high to low"
msgstr "Prezzo: dal più alto"

#: src/Site/Site.php:228
msgid "Best selling"
msgstr "Più venduti"

#: src/Site/Site.php:232
msgid "Top rated"
msgstr "Più votati"

#: build/index.js:4
msgid "Sorting"
msgstr "Ordinamento"

#: build/index.js:4
msgid "The choices shoppers can sort the results by, in the order they show. Change them later in Bitlane’s widget designer."
msgstr "Gli ordinamenti che i clienti possono scegliere per i risultati, nell’ordine in cui appaiono. Puoi cambiarli in seguito nel designer del widget di Bitlane."

#: build/index.js:4
msgid "Search box"
msgstr "Casella di ricerca"

#: build/index.js:4
msgid "CSS selectors for your theme’s search field and button, separated by commas: clicking one opens Bitlane’s search."
msgstr "I selettori CSS del campo e del pulsante di ricerca del tuo tema, separati da virgole: un clic su uno di essi apre la ricerca di Bitlane."

#: build/index.js:2
msgid "A new engine, or one your Bitlane project already has."
msgstr "Un nuovo engine, o uno che il tuo progetto Bitlane ha già."

#: build/index.js:2
msgid "Saving moves the site to this engine: its indexes are made there and filled again, and the current engine’s are deleted. Search has fewer results until the sync is done."
msgstr "Salvando, il sito passa a questo engine: i suoi indici vengono creati lì e riempiti di nuovo, e quelli dell'engine attuale vengono eliminati. La ricerca ha meno risultati finché la sincronizzazione non è finita."
